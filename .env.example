# Copy this file to .env.local and fill in your details.
# .env.local is gitignored and never committed — your credentials stay on your machine.

# ── COROS login ──────────────────────────────────────────────────────────────
# The SAME email and password you use to sign in at https://t.coros.com
COROS_EMAIL=you@example.com
COROS_PASSWORD=your-coros-password

# Your COROS account region: us | eu | cn  (the region your account was created in)
COROS_REGION=us

# ── Sleep stages (optional, advanced) ────────────────────────────────────────
# Sleep-stage data needs the COROS *mobile* API (AES-encrypted login).
# WARNING: enabling this performs a mobile login that can LOG YOU OUT of the
# COROS app on your phone. Leave it at 0 unless you accept that trade-off — the
# rest of the dashboard works fully without it.
COROS_ENABLE_SLEEP=0

# ── AI coach (optional) ──────────────────────────────────────────────────────
# Default backend the in-app toggle starts on: claude | codex | anthropic
#  - claude / codex : run the local Claude Code or Codex CLI. No API key — they
#                     reuse the login you already have on this machine.
#  - anthropic      : call the Anthropic API directly (needs ANTHROPIC_API_KEY).
# The app auto-detects what's installed; this just sets the default.
COACH_PROVIDER=claude

# Only needed for the "anthropic" backend. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model for the "anthropic" backend (Anthropic API).
COACH_MODEL=claude-sonnet-4-6

# Model for the CLI backends (claude / codex), passed through as --model.
# Optional — leave unset to use each CLI's own default.
# COACH_CLI_MODEL=

# Optional overrides for where the CLI binaries live (normally auto-detected).
# CLAUDE_CLI_PATH=/full/path/to/claude
# CODEX_CLI_PATH=/full/path/to/codex
