# Copy to .env.local and fill in. .env.local is gitignored.

# COROS Training Hub login (the same email/password you use at https://t.coros.com)
COROS_EMAIL=you@example.com
COROS_PASSWORD=your-coros-password
# us | eu | cn
COROS_REGION=us

# Sleep-stage data uses the COROS mobile API (AES-encrypted login).
# Set to 1 to enable. Note: mobile login may rotate the token your phone app uses.
COROS_ENABLE_SLEEP=0

# --- AI coach ---
# Default backend: claude | codex | anthropic. CLI backends (claude/codex) reuse
# your existing local login and need NO API key. "anthropic" needs the key below.
COACH_PROVIDER=claude
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-4-6
